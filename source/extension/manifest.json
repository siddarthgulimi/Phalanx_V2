{
  "manifest_version": 3,
  "name": "Phalanx — DOM Integrity & Threat Monitor",
  "short_name": "Phalanx",
  "version": "2.0.0",
  "description": "Lightweight real-time protection against injected login forms, malicious scripts, clickjacking, risky sites and unsafe downloads. Pairs with the Phalanx desktop app.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Phalanx",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["lib/intel.js", "content.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "permissions": ["storage", "downloads", "notifications", "tabs", "webNavigation", "webRequest", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "minimum_chrome_version": "116"
}
